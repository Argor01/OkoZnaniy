# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
DJANGO_ENV=production

# Database settings
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql://postgres:your-postgres-password@postgres:5432/oko_db

# Redis settings
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@redis:6379/0

# Payment encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PAYMENT_ENCRYPTION_KEY=your-fernet-key-here

# Bot settings
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Security settings
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,okoznaniy.ru,www.okoznaniy.ru

# Email settings (Yandex)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yandex.ru
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@yandex.ru

# Frontend URL
FRONTEND_URL=https://okoznaniy.ru

# Google OAuth settings
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# VK OAuth settings (VK ID / vk.com app)
# VK_CLIENT_ID — ID приложения (числовой)
# VK_CLIENT_SECRET — Защищённый ключ (client_secret)
# VK_SERVICE_KEY — Сервисный ключ доступа (для server-side API вызовов)
VK_CLIENT_ID=your-vk-app-id
VK_CLIENT_SECRET=your-vk-secure-key
VK_SERVICE_KEY=your-vk-service-key

# Payment Gateway - KeyGatePay
KEYGATEPAY_MERCHANT_ID=your-merchant-id
KEYGATEPAY_MERCHANT_NAME=your-merchant-name
KEYGATEPAY_SECRET_KEY=your-secret-key
KEYGATEPAY_API_KEY=your-api-key

# Support chat settings
SUPPORT_USER_ID=

# Sentry or GlitchTip (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# T-Bank acquiring
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TEST_MODE=False
TBANK_NOTIFICATION_URL=https://example.com/api/payments/tbank/callback/
TBANK_SUCCESS_URL=https://example.com/payment/success/
TBANK_FAIL_URL=https://example.com/payment/fail/

# --- Эквайринг Банка Уралсиб (шлюз RBS) ---------------------------------
# Тестовый контур; боевой URL банк сообщает при подключении.
URALSIB_API_URL=https://uralsib.rbsuat.com/payment/rest
# Логин и пароль API-пользователя из личного кабинета мерчанта.
# Это НЕ учётные данные для входа в кабинет — отдельный API-пользователь.
URALSIB_USERNAME=
URALSIB_PASSWORD=
# Общий секрет для проверки контрольной суммы колбэка.
# Задаётся в кабинете мерчанта в разделе уведомлений.
# Пока пуст — подпись не проверяется, платёж подтверждается только
# запросом статуса. Для боя заполнить обязательно.
URALSIB_CALLBACK_SECRET=
URALSIB_SUCCESS_URL=https://okoznaniy.ru/payment/success/
URALSIB_FAIL_URL=https://okoznaniy.ru/payment/fail/

# Какой банк обслуживает оплату картой: uralsib или alfabank.
CARD_ACQUIRER=uralsib

# --- Верификация получателей выплат -------------------------------------
# True — без подтверждённого налогового статуса вывод средств запрещён.
# Включать после того, как эксперты пройдут верификацию.
WITHDRAWAL_REQUIRES_VERIFICATION=False
# True — при недоступности ФНС выплата пропускается,
# False — блокируется до восстановления сервиса.
ALLOW_WITHDRAWAL_WHEN_FNS_DOWN=True
NPD_CACHE_MINUTES=60
